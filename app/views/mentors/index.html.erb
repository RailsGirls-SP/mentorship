<p style="color: green"><%= notice %></p>

<% content_for :title, "Mentoras" %>

<h1>Mentoras</h1>

<%= form_with url: mentors_path, method: :get do |f| %>
  <%= f.label :stack_id, "Filtrar por habilidade:" %>
  <%= f.select :stack_id, options_from_collection_for_select(@stacks, :id, :name), include_blank: "Todas" %>
  <%= f.submit "Filtrar" %>
<% end %>

<div id="mentors">
  <table border="1" cellpadding="10">
  <thead>
    <tr>
      <th>Nome</th>
      <th>Email</th>
      <th>Redes Sociais</th>
      <th>Tópicos de Mentoria</th>
      <th>Habilidades</th>
      <th>Conectar com Mentorada</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @mentors.each do |mentor| %>
      <tr>
        <td><%= mentor.name %></td>
        <td><%= mail_to mentor.email, target: "_blank" %></td>
        <td><%= link_to "LinkedIn", safe_url(mentor.linkedin_url), target: "_blank", rel: "noopener" %></td>
        <td><%= format_mentorship_topics(mentor.mentorship_topics) %></td>
        <td><%= mentor.stacks.map(&:name).join(", ") %></td>
        <td>
          <%= form_with model: Mentorship.new, url: mentorships_path do |f| %>
            <%= f.hidden_field :mentor_id, value: mentor.id %>
            <%= f.select :mentee_id, options_from_collection_for_select(@mentees, :id, :name), prompt: "Selecione uma mentorada" %>
            <%= f.submit "Conectar" %>
          <% end %>
        </td>
        <td><%= link_to "Mostrar mais", mentor %></td>
      </tr>
    <% end %>
  </tbody>
  </table>
</div>

<p><%= link_to "Nova mentora", new_mentor_path %></p>
<p><%= link_to "Listar mentoradas", mentees_path %></p>
